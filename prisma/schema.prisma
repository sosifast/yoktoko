// use prisma-8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String
  level     String   @default("Talent")
  balance   Float    @default(0)
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Produk {
  id                 String   @id @default(uuid())
  id_kategori        String
  id_game            String
  nama_produk        String
  slug               String
  harga_jual         Float
  rate_robux_suplier         Float
  rate_robux_dijual          Float
  rate_robux_reseller        Float    @default(0)
  harga_reseller             Float    @default(0)
  harga_robux_sebelum_diskon Float    @default(0)
  harga_robux_sudah_diskon   Float    @default(0)
  penggunaan_robux           Int      @default(0)
  is_discount                Boolean  @default(false)
  create_at                  DateTime @default(now())
  update_at                  DateTime @updatedAt

  @@index([id_game])
  @@index([id_kategori])
  @@index([nama_produk])
}

model Kategori {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Game {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  image_url String?
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Suplier {
  id        String   @id @default(uuid())
  name      String
  slug      String
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Transaksi {
  id                 String   @id @default(uuid())
  id_kategori        String?
  id_game            String?
  id_suplier         String?
  username_tiktok    String?
  username_roblox    String?
  harga              Float    @default(0)
  subtotal           Float    @default(0)
  rate_robux_suplier Float    @default(0)
  rate_robux_dijual  Float    @default(0)
  data_order         Json?
  status             String   @default("Pending")
  kode_unik          Int      @default(0)
  create_at          DateTime @default(now())
  update_at          DateTime @updatedAt

  @@index([status])
  @@index([create_at(sort: Desc)])
  @@index([update_at(sort: Desc)])
  @@index([id_game])
  @@index([id_kategori])
  @@index([id_suplier])
  @@index([subtotal])
}

model reseller_plan {
  id        String   @id @default(uuid())
  paket     String
  price     Float
  durasi    Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model history_reseller_plan {
  id                String   @id @default(uuid())
  id_reseller_plan  String
  id_user           String
  price             Float
  start_date        DateTime
  expired_date      DateTime
  bukti_bayar_url   String?
  status_pembayaran String   @default("Pending")
  is_active         Int      @default(0)
  create_at         DateTime @default(now())
  update_at         DateTime @updatedAt
}
