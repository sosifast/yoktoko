generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Produk {
  id                 String   @id @default(uuid())
  id_kategori        String
  id_game            String
  nama_produk        String
  slug               String
  harga_jual         Float
  rate_robux_suplier Float
  rate_robux_dijual  Float
  penggunaan_robux   Int
  is_discount        Boolean  @default(false)
  create_at          DateTime @default(now())
  update_at          DateTime @updatedAt
}
